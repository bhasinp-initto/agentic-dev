{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic Memory",
  "description": "Append-only orchestrator behavioral memory derived from past observations.",
  "type": "object",
  "required": ["schema_version", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "observation", "consequence"],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD date of the observation"
          },
          "observation": {
            "type": "string",
            "minLength": 10,
            "description": "What was observed during this incident"
          },
          "consequence": {
            "type": "string",
            "minLength": 10,
            "description": "What consequence or correction resulted from this observation"
          }
        }
      }
    }
  }
}
